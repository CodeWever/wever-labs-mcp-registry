{
  "name": "wever-labs-mcp-registry",
  "version": "0.8.2-registry.1",
  "mcpName": "io.github.CodeWever/wever-labs-products",
  "scripts": {
    "test:unit": "python3 -B -m unittest discover -s tests -p 'test_*.py' -v",
    "check:catalog": "python3 scripts/check_catalog_drift.py",
    "check:catalog:published": "python3 -B scripts/check_catalog_drift.py --published && python3 -B scripts/check_registry_versions.py --published",
    "test": "npm run test:unit && npm run check:catalog && npm run check:versions",
    "check:versions": "python3 -B scripts/check_registry_versions.py"
  }
}
